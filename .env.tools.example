# AUTO-GENERATED by scripts/generate_tools_docs.py — do not edit manually.
# Derived from each tool's `config_schema` / `config_defaults`.
# Fill in the values that apply to your deployment in your real `.env`.
#
# Sensitive fields are emitted with a placeholder `__SET_ME__`. NEVER commit
# real secrets to git — use `.env`, a secret manager, or per-org DB config.
#
# Resolution order (lowest → highest precedence):
#   1. config_defaults (hardcoded)
#   2. environment variables (this file)
#   3. per-org DB config (web UI configtool, encrypted)
#   4. per-profile override (when supports_multiple_configs=true)
#


# === Summarize File ===

# --- override: summarize_file ---
# Save checkpoint every N chunks. 0 = no checkpointing.
TOOL_SUMMARIZE_FILE__CHECKPOINT_INTERVAL=5

# Absolute minimum chunk size. Prevents infinite reduction loops.
TOOL_SUMMARIZE_FILE__CHUNK_MIN_CHARS=4000

# Characters from the END of the previous chunk to include at the START of the next chunk.
TOOL_SUMMARIZE_FILE__CHUNK_OVERLAP_CHARS=500

# Target tokens per chunk (~3.8 chars/token). Auto-reduced if LLM reports context limit exceeded.
TOOL_SUMMARIZE_FILE__CHUNK_TOKEN_TARGET=12000

# Model name override. If empty, uses the same maker model as the agent (organization config), then the provider's default from settings.
TOOL_SUMMARIZE_FILE__LLM_MODEL=

# LLM provider for summarization calls. 'inherit' uses the same provider/model as the agent (organization LLM config, falling back to global settings).
TOOL_SUMMARIZE_FILE__LLM_PROVIDER=inherit

# Temperature for summarization calls. Lower = more deterministic, less hallucination. 0.0-0.2 recommended for factual tasks.
TOOL_SUMMARIZE_FILE__LLM_TEMPERATURE=0.1

TOOL_SUMMARIZE_FILE__LLM_TIMEOUT=300

# Maximum LLM iterations before stopping. Returns partial summary with warning if reached.
TOOL_SUMMARIZE_FILE__MAX_ITERATIONS=500

# Approximate tokens from the END of the accumulated summary to show as context (~3.8 chars/token). Higher values preserve more coherence across iterations but consume more prompt space.
TOOL_SUMMARIZE_FILE__SUMMARY_TAIL_TOKENS=2000
